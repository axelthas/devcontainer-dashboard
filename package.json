{
	"name": "devharbour",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:server": "tsc --project tsconfig.server.json",
		"start": "node build/server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:ai": "node --experimental-strip-types --test scripts/tests/ai.test.mjs scripts/tests/ai-frame-ancestors.test.mjs",
		"test:brain": "node --experimental-strip-types --test scripts/tests/brain-access.test.mjs scripts/tests/brain-executions.test.mjs scripts/tests/brain-gateway.test.mjs scripts/tests/brain-mcp.test.mjs scripts/tests/brain-shells.test.mjs scripts/tests/brain-startup.test.mjs scripts/tests/brain-viewers.test.mjs",
		"test:compose": "node --experimental-strip-types --test scripts/tests/compose-sandbox.test.mjs scripts/tests/compose-query.test.mjs",
		"test:terminal-engines": "node --experimental-strip-types --test scripts/tests/terminal-engines.test.mjs",
		"test:deployment": "node --test scripts/tests/deployment.test.mjs scripts/tests/entrypoint-config.test.mjs scripts/tests/run-dashboard.test.mjs scripts/tests/bootstrap-hook.test.mjs scripts/tests/socket-symlink.test.mjs",
		"test:ssh": "node --experimental-strip-types --test scripts/tests/devcontainer-agent.test.mjs scripts/tests/devcontainer-rebuild.test.mjs",
		"test:production": "node scripts/tests/production-smoke.mjs",
		"test:gateway": "node --test scripts/tests/service-gateway.test.mjs && npm run test:tailscale && npm run test:ai && npm run test:brain",
		"test:tailscale": "node --experimental-strip-types --test scripts/tests/tailscale-*.test.mjs",
		"test": "npm run test:cli && npm run test:settings && npm run test:deployment && npm run test:ssh && npm run test:ai && npm run test:brain && npm run test:compose && npm run test:terminal-engines && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:settings:production": "node scripts/tests/settings-production.mjs",
		"test:settings": "node --test scripts/tests/settings.test.mjs scripts/tests/apply.test.mjs",
		"test:cli": "node --test scripts/tests/devharbour.test.mjs scripts/tests/devharbour-wizard.test.mjs scripts/tests/devharbour-source.test.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/dockerode": "^4.0.1",
		"@types/node": "^22",
		"@types/ws": "^8.18.1",
		"@vitest/browser-playwright": "^4.1.3",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@wterm/dom": "0.6.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"dockerode": "^5.0.0",
		"lucide-svelte": "^1.0.1",
		"node-pty": "^1.1.0",
		"wraithterm": "0.6.1",
		"ws": "^8.20.1"
	},
	"allowScripts": {
		"node-pty@1.1.0": true
	}
}
